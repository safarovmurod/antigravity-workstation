  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#74664d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#72486b"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#37685d"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#875e16"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#8a4b25"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#875e16"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#403a2c"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8a4b25"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#72486b"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#8a4b25"
      }
    },
    {
      "scope": [
        "string.quoted.double.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#37685d"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#74664d"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a32538"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#8a4b25"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#875e16",
    "type": "#875e16",
    "class": "#875e16",
    "interface": "#875e16",
    "enum": "#875e16",
    "typeParameter": "#875e16",
    "function": "#8a4b25",
    "method": "#8a4b25",
    "variable": "#403a2c",
    "parameter": "#8a4b25",
    "property": "#403a2c",
    "enumMember": "#875e16",
    "keyword": "#72486b",
    "comment": "#74664d",
    "string": "#37685d",
    "number": "#875e16",
    "operator": "#74664d"
  }
}
