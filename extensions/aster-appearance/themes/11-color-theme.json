  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#52626d"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#684c8e"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#336c60"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#8a541e"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#21627d"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#8a541e"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#28343c"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#21627d"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#684c8e"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#21627d"
      }
    },
    {
      "scope": [
        "string.quoted.double.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#336c60"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#52626d"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#a32538"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#21627d"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#8a541e",
    "type": "#8a541e",
    "class": "#8a541e",
    "interface": "#8a541e",
    "enum": "#8a541e",
    "typeParameter": "#8a541e",
    "function": "#21627d",
    "method": "#21627d",
    "variable": "#28343c",
    "parameter": "#21627d",
    "property": "#28343c",
    "enumMember": "#8a541e",
    "keyword": "#684c8e",
    "comment": "#52626d",
    "string": "#336c60",
    "number": "#8a541e",
    "operator": "#52626d"
  }
