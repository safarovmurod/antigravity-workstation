  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9aa8ba"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#b6a0c9"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ebcb8b"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e1e8f0"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#b6a0c9"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    },
    {
      "scope": [
        "string.quoted.double.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#a3be8c"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#9aa8ba"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f19b9b"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#88c0d0"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#ebcb8b",
    "type": "#ebcb8b",
    "class": "#ebcb8b",
    "interface": "#ebcb8b",
    "enum": "#ebcb8b",
    "typeParameter": "#ebcb8b",
    "function": "#88c0d0",
    "method": "#88c0d0",
    "variable": "#e1e8f0",
    "parameter": "#88c0d0",
    "property": "#e1e8f0",
    "enumMember": "#ebcb8b",
    "keyword": "#b6a0c9",
    "comment": "#9aa8ba",
    "string": "#a3be8c",
    "number": "#ebcb8b",
    "operator": "#9aa8ba"
  }
