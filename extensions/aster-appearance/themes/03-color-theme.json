  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#a1a8b4"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#cfa0e9"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#a5cc84"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#e8bb82"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#77b7e5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#e8bb82"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#dce0e8"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#77b7e5"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#cfa0e9"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#77b7e5"
      }
    },
    {
      "scope": [
        "string.quoted.double.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#a5cc84"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#a1a8b4"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f19b9b"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#77b7e5"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#e8bb82",
    "type": "#e8bb82",
    "class": "#e8bb82",
    "interface": "#e8bb82",
    "enum": "#e8bb82",
    "typeParameter": "#e8bb82",
