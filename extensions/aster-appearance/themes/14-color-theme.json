  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#b39fa9"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "keyword.control.import",
        "keyword.control.export"
      ],
      "settings": {
        "foreground": "#bda8d2"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#b1c5a2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#d9b992"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#dba1aa"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#d9b992"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.object-literal.key",
        "support.variable"
      ],
      "settings": {
        "foreground": "#ebdce2"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#dba1aa"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#bda8d2"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css"
      ],
      "settings": {
        "foreground": "#dba1aa"
      }
    },
    {
      "scope": [
        "string.quoted.double.json",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b1c5a2"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#b39fa9"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f19b9b"
      }
    },
    {
      "scope": [
        "markup.heading",
        "markup.bold"
      ],
      "settings": {
        "foreground": "#dba1aa"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#d9b992",
    "type": "#d9b992",
    "class": "#d9b992",
    "interface": "#d9b992",
    "enum": "#d9b992",
    "typeParameter": "#d9b992",
    "function": "#dba1aa",
    "method": "#dba1aa",
    "variable": "#ebdce2",
    "parameter": "#dba1aa",
    "property": "#ebdce2",
    "enumMember": "#d9b992",
    "keyword": "#bda8d2",
    "comment": "#b39fa9",
    "string": "#b1c5a2",
    "number": "#d9b992",
    "operator": "#b39fa9"
  }
