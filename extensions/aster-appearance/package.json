{
  "name": "aster-appearance",
  "displayName": "Aster Atelier",
  "publisher": "workstation",
  "version": "1.0.2",
  "description": "Twenty original editor palettes and ten programming fonts. A focused appearance studio for Antigravity.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "icon.png",
  "main": "./extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/safarovmurod/antigravity-workstation.git",
    "directory": "extensions/aster-appearance"
  },
  "contributes": {
    "themes": [
      {
        "label": "oceanic pro",
        "uiTheme": "vs-dark",
        "path": "./themes/01-color-theme.json"
      },
      {
        "label": "nord polar",
        "uiTheme": "vs-dark",
        "path": "./themes/02-color-theme.json"
      },
      {
        "label": "one dark",
        "uiTheme": "vs-dark",
        "path": "./themes/03-color-theme.json"
      },
      {
        "label": "git hab light",
        "uiTheme": "vs",
        "path": "./themes/04-color-theme.json"
      },
      {
        "label": "nord light",
        "uiTheme": "vs",
        "path": "./themes/05-color-theme.json"
      },
      {
        "label": "material ligth",
        "uiTheme": "vs",
        "path": "./themes/06-color-theme.json"
      },
      {
        "label": "horizon light",
        "uiTheme": "vs",
        "path": "./themes/07-color-theme.json"
      },
      {
        "label": "grafite pro",
        "uiTheme": "vs-dark",
        "path": "./themes/08-color-theme.json"
      },
      {
        "label": "slate nigth",
        "uiTheme": "vs-dark",
        "path": "./themes/09-color-theme.json"
      },
      {
        "label": "show gray",
        "uiTheme": "vs",
        "path": "./themes/10-color-theme.json"
      },
      {
        "label": "titanium",
        "uiTheme": "vs",
        "path": "./themes/11-color-theme.json"
      },
      {
        "label": "ligth",
        "uiTheme": "vs",
        "path": "./themes/12-color-theme.json"
      },
      {
        "label": "black",
        "uiTheme": "vs-dark",
        "path": "./themes/13-color-theme.json"
      },
      {
        "label": "crimson pro",
        "uiTheme": "vs-dark",
        "path": "./themes/14-color-theme.json"
      },
      {
        "label": "ocean wawe",
        "uiTheme": "vs-dark",
        "path": "./themes/15-color-theme.json"
      },
      {
        "label": "neon cyan",
        "uiTheme": "vs-dark",
        "path": "./themes/16-color-theme.json"
      },
      {
        "label": "Amber Ledger",
        "uiTheme": "vs-dark",
        "path": "./themes/17-color-theme.json"
      },
      {
        "label": "Orchid Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/18-color-theme.json"
      },
      {
        "label": "Sandstone Studio",
        "uiTheme": "vs",
        "path": "./themes/19-color-theme.json"
      },
      {
        "label": "Evergreen Terminal",
        "uiTheme": "vs-dark",
        "path": "./themes/20-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "asterAppearance.open",
        "title": "Aster Atelier: Appearance Studio"
      }
    ],
    "configuration": {
      "title": "Aster Atelier",
      "properties": {
        "asterAppearance.fontStyle": {
          "type": "string",
          "enum": [
            "normal",
            "italic"
          ],
          "default": "normal",
          "scope": "application",
          "description": "Editor token style. Uses supported TextMate and semantic styling; does not patch the IDE."
        }
      }
    }
  }
}
