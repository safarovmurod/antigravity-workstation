{
  "name": "stability-helper",
  "displayName": "Workstation Stability",
  "description": "Применяет профиль редактора и проверяет конфликты настроек.",
  "publisher": "workstation",
  "version": "1.3.10",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "workstationStability.questions",
        "title": "Workstation: Вопросы задачи (галочки и свой вариант)"
      },
      {
        "command": "workstationStability.status",
        "title": "Workstation: Check Antigravity Stability"
      },
      {
        "command": "workstationStability.repair",
        "title": "Workstation: Restore Known Extension Fixes"
      },
      {
        "command": "workstationStability.reconnectMcp",
        "title": "Workstation: Reconnect MCP (Reload Window)"
      },
      {
        "command": "workstationStability.applySettings",
        "title": "Workstation: Apply and Check Editor Settings"
      },
      {
        "command": "workstationStability.inspectConflicts",
        "title": "Workstation: Inspect Project Setting Conflicts (Read Only)"
      },
      {
        "command": "workstationStability.retrySetupRepair",
        "title": "Workstation: Retry Setup Repair Task in Current Chat"
      }
    ],
    "keybindings": [
      {
        "key": "ctrl+shift+f",
        "command": "editor.action.formatDocument",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+alt+f",
        "command": "editor.action.formatDocument",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+space",
        "command": "editor.action.triggerSuggest",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "alt+space",
        "command": "editor.action.triggerSuggest",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "key": "ctrl+m",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "ctrl+m",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "m",
        "command": "-antigravity.stopVoiceRecording"
      },
      {
        "key": "enter",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "enter",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "ctrl+enter",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "ctrl+enter",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "shift+enter",
        "command": "-antigravity.startVoiceRecording"
      },
      {
        "key": "shift+enter",
        "command": "-antigravity.toggleVoiceRecording"
      },
      {
        "key": "ctrl+m",
        "command": "-workbench.action.speech.startVoiceChat"
      },
      {
        "key": "ctrl+m",
        "command": "-workbench.action.speech.startListening"
      },
      {
        "key": "ctrl+m",
        "command": "-workbench.action.speech.stopListening"
      }
    ]
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/safarovmurod/antigravity-workstation.git",
    "directory": "extensions/workstation-stability"
  }
}
